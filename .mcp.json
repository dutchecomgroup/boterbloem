{
  "mcpServers": {
    "playwright": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@0.0.79",
        "--headless",
        "--viewport-size",
        "1440x900",
        "--user-data-dir",
        ".playwright-profile"
      ]
    }
  }
}
