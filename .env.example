# --- Database ---
# Eén live Postgres op de VPS. Geen aparte dev-database.
#
# De host bepaalt of TLS wordt afgedwongen (zie server/db.ts):
#   localhost / 127.0.0.1  -> geen TLS (loopback op de VPS zelf)
#   elke andere host       -> TLS VERPLICHT, de verbinding faalt zonder
#
# Op de VPS:
#   DATABASE_URL=postgresql://abb_app:WACHTWOORD@localhost:5432/atelierboterbloem
#
# Lokaal, aanbevolen — via een SSH-tunnel, dan gaat er niets onversleuteld het net op:
#   ssh -L 5432:localhost:5432 root@85.215.182.227
#   DATABASE_URL=postgresql://abb_app:WACHTWOORD@localhost:5432/atelierboterbloem
#
# Lokaal, rechtstreeks (werkt zolang poort 5432 open staat; TLS wordt afgedwongen):
DATABASE_URL=postgresql://abb_app:CHANGE_ME@85.215.182.227:5432/atelierboterbloem

# --- Server ---
PORT=6778
# development lokaal, production op de VPS.
# Let op: NODE_ENV=production zet `secure` op de sessiecookie, en die wordt niet
# meegestuurd over http://localhost — inloggen lukt dan lokaal niet.
NODE_ENV=development

# Overschrijft de `secure`-vlag op de sessiecookie; laat leeg tenzij je weet waarom niet.
# Alleen nodig als de app in productie draait op een adres zonder HTTPS: NODE_ENV=production
# is namelijk ook wat de gebouwde site serveert, en een `secure`-cookie wordt over gewoon
# http:// niet bewaard, dus inloggen mislukt met een kloppend wachtwoord. Weghalen zodra er
# een certificaat is -- het wachtwoord gaat tot die tijd leesbaar over de lijn.
# COOKIE_SECURE=false

# --- Session ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# --- Uploads ---
UPLOADS_DIR=./uploads
MAX_UPLOAD_MB=10

# --- Site ---
PUBLIC_BASE_URL=http://localhost:6778
